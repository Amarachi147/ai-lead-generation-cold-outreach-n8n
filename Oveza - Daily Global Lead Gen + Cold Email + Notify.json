        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const list = $json.searchTargets.split('|').map(s => s.trim()).filter(Boolean); const n = Number($json.searchesPerDay) || 3; const out = []; for (let k = 0; k < n; k++) { const idx = $now.ordinal * n + k; const parts = list[idx % list.length].split('~'); out.push({ q: parts[0], gl: parts[1], hl: parts[2], num: 10, page: (Math.floor(idx / list.length) % 3) + 1 }); } return JSON.stringify(out); })() }}",
        "options": {}
