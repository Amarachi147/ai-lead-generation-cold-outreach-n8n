    {
      "parameters": {
        "jsCode": "const blocked = ['linkedin.com','facebook.com','instagram.com','twitter.com','x.com','youtube.com','yelp.com','yellowpages.com','yellowpages.ca','trustpilot.com','tripadvisor.com','justdial.com','sulekha.com','indiamart.com','practo.com','99acres.com','magicbricks.com','autotrader.com','cars.com','cargurus.com','carsales.com.au','truelocal.com.au','realestate.com.au','domain.com.au','zillow.com','realtor.com','redfin.com','houzz.com','booksy.com','fresha.com','treatwell.com','pagesjaunes.fr','paginasamarillas.es','doctolib.fr','topdoctors.es','idealista.com','fotocasa.es','seloger.com','kijiji.ca','avvo.com','findlaw.com','lawyers.com','healthgrades.com','birdeye.com','angi.com','thumbtack.com','bbb.org','mapquest.com','wikipedia.org','tiktok.com','pinterest.com','reddit.com','glassdoor.com','indeed.com','clutch.co','crunchbase.com','medium.com','quora.com','forbes.com','amazon.com','google.com'];\nconst langMap = { es: 'Spanish', fr: 'French' };\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const res = item.json || {};\n  const sp = res.searchParameters || {};\n  const organic = res.organic || [];\n  for (const r of organic) {\n    let host;\n    const m = String(r.link || '').match(/^https?:\\/\\/([^\\/?#:]+)/i);\n    if (!m) continue;\n    host = m[1].replace(/^www\\./, '').toLowerCase();\n    if (host.endsWith('.ng')) continue;                      // exclude Nigeria\n    if (/\\.(gov|edu)(\\.[a-z]{2})?$/.test(host) || host.includes('.gouv.')) continue;\n    if (blocked.some(b => host === b || host.endsWith('.' + b))) continue;\n    if (seen.has(host)) continue;\n    seen.add(host);\n    out.push({ json: {\n      company: (r.title || host).split(/[-|–—:]/)[0].trim(),\n      website: 'https://' + host,\n      domain: host,\n      snippet: r.snippet || '',\n      country: (sp.gl || '').toUpperCase(),\n      language: langMap[sp.hl] || 'English',\n      searchQuery: sp.q || ''\n    }});\n  }\n}\nreturn out;"
      },
