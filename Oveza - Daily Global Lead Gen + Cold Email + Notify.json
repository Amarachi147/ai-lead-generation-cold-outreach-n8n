    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Lead Ready').item.json;\nconst j = $json;\nlet c = (j.message && j.message.content) || (j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content) || j.text || (j.output && j.output[0] && j.output[0].content && j.output[0].content[0] && j.output[0].content[0].text) || j.content || '';\nlet mail;\nif (c && typeof c === 'object' && !Array.isArray(c)) {\n  mail = c;\n} else {\n  const raw = typeof c === 'string' ? c : JSON.stringify(c);\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (!m) throw new Error('The AI did not return JSON for ' + lead.domain + ': ' + raw.slice(0, 200));\n  mail = JSON.parse(m[0]);\n}\nif (!mail.subject || !mail.body) throw new Error('Missing subject or body for ' + lead.domain);\nreturn { json: { ...lead, subject: mail.subject, body: mail.body } };"
      },
