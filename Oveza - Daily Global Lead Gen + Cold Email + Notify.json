    {
      "parameters": {
        "jsCode": "const existing = new Set(\n  $('Get Existing Leads').all().map(i => (i.json.Domain || '').toLowerCase()).filter(Boolean)\n);\nconst max = $('Config').first().json.maxLeadsPerDay || 10;\nconst fresh = $('Extract Candidates').all().filter(i => !existing.has(i.json.domain));\n// round-robin across countries so every country gets a share\nconst groups = {};\nfresh.forEach(i => { (groups[i.json.country] = groups[i.json.country] || []).push(i); });\nconst keys = Object.keys(groups);\nconst out = [];\nlet added = true;\nwhile (out.length < max && added) {\n  added = false;\n  for (const k of keys) {\n    if (groups[k].length && out.length < max) { out.push(groups[k].shift()); added = true; }\n  }\n}\nreturn out;"
      },
