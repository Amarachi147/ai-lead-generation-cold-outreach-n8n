    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst sent = rows.filter(r => r.Status === 'Email sent');\nconst failed = rows.filter(r => r.Status === 'Send failed');\nconst none = rows.filter(r => r.Status === 'No email found');\nconst date = $now.toFormat('dd LLL yyyy');\nlet msg = 'Oveza lead report - ' + date + '\\n\\n';\nmsg += 'Cold emails sent: ' + sent.length + '\\n';\nif (failed.length) msg += 'Send failed: ' + failed.length + '\\n';\nmsg += 'Leads with no email found: ' + none.length + '\\n';\nif (sent.length) {\n  msg += '\\nSent to:\\n';\n  sent.forEach((r, i) => { msg += (i + 1) + '. ' + r.Company + ' [' + r.Country + '] - ' + r['Contact Email'] + ' (' + r.Website + ')\\n'; });\n}\nmsg += '\\nAll leads are logged in your Google Sheet.';\nreturn [{ json: { message: msg, subject: 'Oveza lead report ' + date + ': ' + sent.length + ' emails sent' } }];"
      },
