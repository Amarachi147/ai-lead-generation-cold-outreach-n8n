          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "You are an expert B2B cold email copywriter. You write short, honest, personalised emails that sound human, in the language requested. Always reply with JSON only.",
              "role": "system"
            },
            {
              "content": "={{ (() => {\nconst c = $('Config').first().json;\nconst l = $json;\nreturn 'Write a cold outreach email in ' + l.language + ' to ' + (l.contactFirstName || 'the team') + ' at ' + l.organization + ' (website: ' + l.website + ', country: ' + l.country + '). Business type we searched for: ' + l.searchQuery + '. Context from their Google listing: ' + l.snippet + '\\n\\nMy name: ' + c.yourName + '\\nMy company: ' + c.yourCompany + '\\nWhat we offer: ' + c.yourOffer + '\\n\\nRules: write the subject and body in ' + l.language + '. Under 110 words, plain text, friendly and specific to their type of business. Mention one or two realistic automation ideas relevant to that business type (for example booking reminders, enquiry replies, lead follow-up, invoicing). ONE clear low-pressure call to action (a short reply or a 15-minute call). Do not invent facts, results, clients or numbers. No hype, no emojis. End with one short opt-out line (in ' + l.language + ') saying they can reply \"no thanks\" and you will not email again. Sign off with my name and company.\\n\\nReturn ONLY valid JSON in this exact shape: {\"subject\": \"...\", \"body\": \"...\"}';\n})() }}"
            }
          ]
        },
        "options": {
          "maxTokens": 700,
          "temperature": 0.7
        }
      },
      "id": "94078ac8-1fee-4cc2-8e08-69d7d0fd29aa",
      "name": "Write Cold Email (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.1,
